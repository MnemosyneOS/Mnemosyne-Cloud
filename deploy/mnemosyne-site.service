[Unit]
Description=Mnemosyne site server (ai-memory.net GitHub sign-in)
Documentation=file:///var/www/ai-memory/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=caddy
Group=caddy
WorkingDirectory=/var/www/ai-memory

# the service binds to loopback only; Caddy reverse-proxies /auth and /api to it
Environment=PORT=8789
Environment=BIND=127.0.0.1
Environment=PUBLIC_BASE_URL=https://ai-memory.net
Environment=PYTHONUNBUFFERED=1

ExecStart=/usr/bin/python3 /var/www/ai-memory/server.py
Restart=always
RestartSec=3

# it only needs to read the site and write its own session store
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/ai-memory

[Install]
WantedBy=multi-user.target
