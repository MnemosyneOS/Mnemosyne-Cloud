<!-- ================================ HERO ================================ -->
<section id="top" class="relative pt-14 sm:pt-20 pb-14 sm:pb-20">
  <div class="max-w-shell mx-auto px-5 sm:px-8">

    <div class="max-w-5xl mx-auto text-center">

      <div class="flex justify-center reveal">
        <span class="pill">
          <span class="dot" aria-hidden="true"></span>
          <span data-i18n="hero.badge">Mnemosyne OS 7.0.2</span>
          <span aria-hidden="true" style="opacity:.45">·</span>
          <span data-i18n="hero.badge2">Zero-cloud memory layer</span>
        </span>
      </div>

      <h1 class="h1 mt-7 reveal">
        <span class="l1" data-i18n="hero.l1">Zero-cloud memory</span>
        <span class="l2" data-i18n="hero.l2">for AI agents.</span>
      </h1>

      <p class="lede mt-6 reveal" style="margin-left:auto;margin-right:auto" data-i18n-html="hero.lede">A local-first memory engine that runs on the Python standard library alone. <b>Sub-millisecond writes</b>, <b>a hash-chained audit ledger</b>, and <b>pure SQLite storage</b> — no vector cloud, no vendor lock-in, no data leaving your machine.</p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3 reveal">
        <a class="btn btn-accent btn-lg" href="#/login"><span data-i18n="hero.start">Get started</span><span class="btn-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></span></a>
        <a class="btn btn-dark btn-lg" href="#/mcp">
          <i data-lucide="plug" style="width:15px;height:15px"></i>
          <span data-i18n="hero.setup">Agent setup</span>
        </a>
      </div>

      <div class="mt-8 flex justify-center reveal">
        <div class="pageseg">
          <a href="#/docs"><i data-lucide="square-code"></i><span data-i18n="hero.seg1">SDK</span></a>
          <a href="#/mcp"><i data-lucide="waypoints"></i><span data-i18n="hero.seg2">Agent harness</span></a>
          <a href="#/cli"><i data-lucide="puzzle"></i><span data-i18n="hero.seg3">Plugins</span></a>
        </div>
      </div>
    </div>

    <!-- language-tabbed code window, exactly like mem0's hero code block -->
    <div class="mt-14 term reveal" id="terminal">
      <div class="term-bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <div class="flex gap-1 flex-wrap" role="tablist" aria-label="Code examples" id="code-tabs"></div>
        <button class="btn btn-quiet btn-sm ml-auto" id="copy-btn" style="color:#71717A">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2.5"/><path d="M5.5 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5v1"/></svg>
          <span id="copy-label" data-i18n="code.copy">Copy</span>
        </button>
      </div>
      <div id="code-panes"></div>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 mono text-[11.5px] text-fg3 reveal">
      <span data-i18n="hero.mounts">Mounts into</span>
      <span class="text-fg2">Claude Code</span><span class="text-faint">/</span>
      <span class="text-fg2">Cursor</span><span class="text-faint">/</span>
      <span class="text-fg2">OpenWebUI</span><span class="text-faint">/</span>
      <span class="text-fg2">Hermes Agent</span><span class="text-faint">/</span>
      <span class="text-fg2">DeepSeek Harness</span><span class="text-faint">/</span>
      <span class="text-fg2">LangChain</span><span class="text-faint">/</span>
      <span class="text-fg2">Ollama</span>
      <a class="text-accent underline-offset-2 hover:underline" href="#/integrations" data-i18n="hero.seeAll">see all →</a>
    </div>
  </div>
</section>

