<!-- =========================== HOW IT WORKS =========================== -->
<section id="how" class="section-pad">
  <div class="max-w-shell mx-auto px-5 sm:px-8">
    <div class="reveal">
      <span class="eyebrow-lg" data-i18n="how.eyebrow">How it works</span>
      <h2 class="h2 mt-4 max-w-3xl" data-i18n="how.h2">Retain anything. Mnemosyne OS learns.</h2>
      <p class="sub mt-5 max-w-2xl" data-i18n="how.sub">Three stages run on every write and every read. No configuration, no boilerplate, no pipeline to rewire.</p>
    </div>
