  },
  changelog: {
    crumb: '参考', h1: '更新日志',
    lead: '本站与记忆系统最近的变化。每条都对应一次实际交付，没有占位条目。',
    blocks: [
      { h: '2026-09-22', id: 'd1', blocks: [
