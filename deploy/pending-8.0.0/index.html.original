<!-- ============================ ARCHITECTURE ============================ -->
<section id="architecture" class="section-pad">
  <div class="max-w-shell mx-auto px-5 sm:px-8">

    <div class="text-center reveal">
      <span class="pill" data-i18n="arch.eyebrow">Architecture</span>
      <h2 class="h2 mt-6 mx-auto max-w-3xl" data-i18n="arch.h2">BEAM — bi-layer episodic and associative memory.</h2>
      <p class="sub mt-5 mx-auto max-w-2xl" data-i18n="arch.sub">Things that happened in time and things that relate to each other are structurally different. BEAM stores them differently, then assembles a single injection under a token budget.</p>
    </div>

    <div class="mt-14 grid lg:grid-cols-2 gap-10 lg:gap-14 items-start">

      <div class="reveal" id="arch-layers"></div>

      <div class="reveal">
        <div class="wire">
          <svg viewBox="0 0 560 430" role="img" aria-label="BEAM wireframe">
            <defs>
              <linearGradient id="fade" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.05"/>
                <stop offset="55%" stop-color="#FFFFFF" stop-opacity="0"/>
                <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.05"/>
              </linearGradient>
              <clipPath id="sweepClip"><rect x="0" y="0" width="560" height="430"/></clipPath>
              <path id="pL1" d="M 96 86 Q 190 86 280 215"/>
              <path id="pL2" d="M 96 215 L 280 215"/>
              <path id="pL3" d="M 96 344 Q 190 344 280 215"/>
              <path id="pR1" d="M 280 215 Q 370 86 464 86"/>
              <path id="pR2" d="M 280 215 L 464 215"/>
              <path id="pR3" d="M 280 215 Q 370 344 464 344"/>
            </defs>
            <line x1="96" y1="86" x2="96" y2="344" stroke="#27272A" stroke-width="1" stroke-dasharray="3 5"/>
            <line x1="464" y1="86" x2="464" y2="344" stroke="#27272A" stroke-width="1" stroke-dasharray="3 5"/>
            <g fill="none" stroke="#3F3F46" stroke-width="1">
              <path d="M 96 86 Q 190 86 280 215"/><path d="M 96 215 L 280 215"/><path d="M 96 344 Q 190 344 280 215"/>
              <path d="M 280 215 Q 370 86 464 86"/><path d="M 280 215 L 464 215"/><path d="M 280 215 Q 370 344 464 344"/>
            </g>
            <g fill="#9B8DFF">
              <circle r="2.6" opacity="0.95"><animateMotion dur="3.4s" repeatCount="indefinite" begin="0s"><mpath href="#pL1"/></animateMotion></circle>
              <circle r="2.6" opacity="0.95"><animateMotion dur="3.4s" repeatCount="indefinite" begin="1.13s"><mpath href="#pL2"/></animateMotion></circle>
              <circle r="2.6" opacity="0.95"><animateMotion dur="3.4s" repeatCount="indefinite" begin="2.27s"><mpath href="#pL3"/></animateMotion></circle>
            </g>
            <g fill="#A1A1AA">
              <circle r="2.2" opacity="0.8"><animateMotion dur="3.1s" repeatCount="indefinite" begin="0.4s"><mpath href="#pR1"/></animateMotion></circle>
              <circle r="2.2" opacity="0.8"><animateMotion dur="3.1s" repeatCount="indefinite" begin="1.43s"><mpath href="#pR2"/></animateMotion></circle>
              <circle r="2.2" opacity="0.8"><animateMotion dur="3.1s" repeatCount="indefinite" begin="2.47s"><mpath href="#pR3"/></animateMotion></circle>
            </g>
            <g>
              <circle cx="96" cy="86" r="5" fill="#0B0B0E" stroke="#52525B" stroke-width="1.2"/>
              <circle cx="96" cy="215" r="5" fill="#0B0B0E" stroke="#52525B" stroke-width="1.2"/>
              <circle cx="96" cy="344" r="5" fill="#0B0B0E" stroke="#52525B" stroke-width="1.2"/>
              <circle cx="464" cy="86" r="5" fill="#0B0B0E" stroke="#52525B" stroke-width="1.2"/>
              <circle cx="464" cy="215" r="5" fill="#0B0B0E" stroke="#52525B" stroke-width="1.2"/>
              <circle cx="464" cy="344" r="5" fill="#0B0B0E" stroke="#52525B" stroke-width="1.2"/>
            </g>
            <circle cx="280" cy="215" r="34" fill="none" stroke="#27272A" stroke-width="1"/>
            <circle cx="280" cy="215" r="22" fill="none" stroke="#9B8DFF" stroke-opacity="0.26" stroke-width="1" stroke-dasharray="2 4">
              <animateTransform attributeName="transform" type="rotate" from="0 280 215" to="360 280 215" dur="26s" repeatCount="indefinite"/>
            </circle>
            <circle cx="280" cy="215" r="8" fill="#0B0B0E" stroke="#9B8DFF" stroke-width="1.4">
              <animate attributeName="r" values="8;9.4;8" dur="4.2s" repeatCount="indefinite"/>
            </circle>
            <g font-family="DM Mono, monospace" font-size="10.5" fill="#71717A">
              <text x="24" y="80">WORKING</text>
              <text x="24" y="209">EPISODIC</text>
              <text x="24" y="338">TRIPLESTORE</text>
              <text x="470" y="80" text-anchor="end">CONTEXT</text>
              <text x="470" y="209" text-anchor="end">RECALL</text>
              <text x="470" y="338" text-anchor="end">GRAPH</text>
              <text x="280" y="194" text-anchor="middle" fill="#A1A1AA">fusion</text>
              <text x="280" y="258" text-anchor="middle" fill="#52525B">t = live</text>
            </g>
            <g clip-path="url(#sweepClip)">
              <rect x="0" y="-46" width="560" height="46" fill="url(#fade)" opacity="0.9">
                <animate attributeName="y" values="-46;430" dur="7.5s" repeatCount="indefinite"/>
              </rect>
            </g>
            <rect x="0.5" y="0.5" width="559" height="429" fill="none" stroke="rgba(255,255,255,0.05)"/>
          </svg>
        </div>
        <div class="wire-legend">
          <span><i class="hot"></i><span data-i18n="arch.lgWrite">write path</span></span>
          <span><i></i><span data-i18n="arch.lgRead">recall path</span></span>
          <span><i class="dash"></i><span data-i18n="arch.lgChain">temporal chain</span></span>
        </div>
        <p class="mt-3 text-[12.5px] leading-[1.7] text-fg3" data-i18n="arch.wireNote">Pure wireframe — every line and packet is drawn in-browser with SVG. No library, no canvas, no colour noise.</p>
      </div>
    </div>
  </div>
</section>

