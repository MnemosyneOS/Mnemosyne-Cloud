      'use-cases/sales-crm': {
        eyebrow: '用例', h1: '销售与客户关系管理',
        lede: 'CRM 里的记录大多是结构化事实，而成交线索往往在它们周围那些没被结构化的上下文里。Mnemosyne OS 记住的是决定为什么被做出，而不只是被做出过。',
        cta: [['全部用例', '#/usecases', 'primary'], ['开始构建', '#/docs', 'ghost']],
        blocks: [
          { h: '会改变什么',
            cards: [
