         positioning statement on the left, the technical argument on the right -->
    <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.08fr)] gap-10 lg:gap-20 items-start reveal">
      <div>
        <span class="pill" data-i18n="proof.eyebrow">Product</span>
        <h2 class="h2 mt-6" data-i18n-html="proof.h2">Built for developers who want proof, not promises</h2>
      </div>
      <div class="lg:pt-2">
        <p class="sub" data-i18n="proof.sub">Mnemosyne OS gives agents persistent memory without a pipeline change. Less redundant context, lower token cost, measurably faster responses.</p>
        <a class="btn btn-accent mt-8" href="#terminal"><span data-i18n="proof.try">Try it now</span><span class="btn-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></span></a>
