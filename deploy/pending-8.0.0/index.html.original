<!-- ============================ ENTERPRISE ============================ -->
<section id="enterprise" class="section-pad">
  <div class="max-w-shell mx-auto px-5 sm:px-8">
    <div class="text-center reveal">
      <span class="pill" data-i18n="ent.eyebrow">Enterprise</span>
      <h2 class="h2 mt-6 mx-auto max-w-3xl" data-i18n="ent.h2">Built for enterprise. Designed for control.</h2>
      <p class="sub mt-5 mx-auto max-w-2xl" data-i18n="ent.sub">Memory at scale is infrastructure. Mnemosyne OS gives teams governance, portability and full observability so engineers spend time building, not recovering lost context.</p>
    </div>
    <div class="mt-14 grid md:grid-cols-3 gap-4" id="ent-grid"></div>
    <div class="mt-10 card card-pad reveal">
      <p class="text-[13.5px] leading-[1.75] text-fg2" data-i18n="ent.compliance">Compliance is documented rather than asserted: a mapping for HIPAA, 等保, GDPR and PIPL ships with the repository, alongside a SHA-256 hash-chain ledger that makes tampering detectable rather than deniable.</p>
      <div class="mt-5 flex flex-wrap gap-2.5" id="ent-badges"></div>
    </div>
  </div>
</section>

