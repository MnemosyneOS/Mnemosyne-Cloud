          ['POST', '<code>/v1/memories</code>', '写入一条记忆'],
          ['GET', '<code>/v1/memories/{id}</code>', '取一条记忆的全文'],
          ['DELETE', '<code>/v1/memories/{id}</code>', '遗忘一条记忆（软删除）'],
          ['POST', '<code>/v1/recall</code>', '按语义检索，可指定返回条数'],
          ['GET', '<code>/v1/graph</code>', '知识图谱的节点与边']
