          { h: '合规姿态',
            p: 'HIPAA 的映射与机制一起维护，部署形态让数据驻留始终在你的掌控内 —— 院内、私有云或完全气隙。',
            tiles: [['HIPAA', '映射持续维护'], ['0 出网', '可气隙运行'], ['SHA-256', '哈希链账本'], ['本地', '你的基础设施']] }
        ]
      },

      'use-cases/education': {
        eyebrow: '用例', h1: '教育',
