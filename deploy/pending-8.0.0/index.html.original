  'api-reference': {
    crumb: '参考', h1: 'API 参考',
    lead: '本站提供一组 HTTP 接口，用控制台里创建的密钥调用。密钥以 Bearer 令牌的形式传递，服务端只保存它的哈希。',
    blocks: [
