    def handle_dash_key_revoke(self):
        me = self.dash_admin_guard()
        if not me:
            return
        body = self.body_json() or {}
        kid = str(body.get('id') or '')
        with LOCK:
            state = dash_state()
            hit = False
            for k in state['keys']:
                if k.get('id') == kid:
                    k['revoked'] = True
                    k['revoked_at'] = time.time()
                    hit = True
            dash_save(state)
        self.send_json(200 if hit else 404, {'ok': hit})

    def key_public(self, k):
        return {'id': k.get('id'), 'name': k.get('name'), 'prefix': k.get('prefix'),
                'created_at': k.get('created_at'), 'last_used': k.get('last_used'),
                'calls': k.get('calls') or 0, 'revoked': bool(k.get('revoked')),
