                    'owner': me.get('id') or '',
                }
                state['keys'].insert(0, row)
                dash_save(state)
                return self.send_json(201, {'ok': True, 'key': raw, 'row': self.key_public(row)})
            rows = [self.key_public(k) for k in state['keys']]
