def llm_chat(messages, timeout=75, max_tokens=900, temperature=0.25):
    """One chat completion. Returns (ok, text, meta).

    meta carries `model` and `usage` on success, or an `error` code plus a
    short detail on failure. `error` values are deliberately distinguishable
    (not_configured / disabled / transport / upstream / shape) because
    "no key" and "the provider refused" need different fixes.
    """
    cfg = llm_config()
    if cfg.get('enabled') is False:
        return False, '', {'error': 'disabled'}
    key = str(cfg.get('apiKey') or '').strip()
    if not key:
        return False, '', {'error': 'not_configured'}
    base = str(cfg.get('baseUrl') or 'https://api.siliconflow.cn/v1').rstrip('/')
    model = str(cfg.get('model') or LLM_DEFAULT_MODEL)
    payload = {'model': model, 'messages': messages,
               'max_tokens': int(max_tokens), 'temperature': float(temperature)}
    ok, data, raw = http_json(base + '/chat/completions', payload,
                              {'Authorization': 'Bearer ' + key}, timeout=timeout)
    if not ok:
        detail = ''
        if isinstance(data, dict):
            err = data.get('error')
            detail = (err.get('message') if isinstance(err, dict) else err) or ''
        detail = detail or str(raw)[:300]
        return False, '', {'error': 'transport', 'detail': detail, 'model': model}
    if isinstance(data, dict) and data.get('error'):
        return False, '', {'error': 'upstream',
                           'detail': str(data['error'])[:300], 'model': model}
    try:
        text = (data['choices'][0]['message']['content'] or '').strip()
    except Exception:
        return False, '', {'error': 'shape', 'detail': str(raw)[:300], 'model': model}
    if not text:
        return False, '', {'error': 'empty', 'model': model}
    return True, text, {'model': data.get('model') or model,
                        'usage': data.get('usage') or {}}


