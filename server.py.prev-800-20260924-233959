def otp_mail(purpose, code, zh):
    """(subject, plain text, html) for one verification code.

    Same sentences in both parts, so a text-only reader and a rich one are
    told exactly the same thing. The wording states the code, its lifetime
    and an invitation to write back — the house style for this product.
    """
    minutes = OTP_TTL // 60
    if purpose == 'reset':
        act_zh, act_en = '重置密码', 'password reset'
        tail_zh = '如果不是你本人操作，请忽略这封邮件，你的密码不会被更改。'
        tail_en = 'If this was not you, ignore this message — your password stays unchanged.'
        head_zh, head_en = '密码重置验证码', 'password reset code'
    elif purpose == 'signin':
        act_zh, act_en = '登录', 'sign-in'
        tail_zh = '如果不是你本人操作，请忽略这封邮件。'
        tail_en = 'If this was not you, ignore this message.'
        head_zh, head_en = '登录验证码', 'sign-in verification code'
    else:
        act_zh, act_en = '注册', 'sign-up'
        tail_zh = '如果不是你本人操作，请忽略这封邮件。'
        tail_en = 'If this was not you, ignore this message.'
        head_zh, head_en = '注册验证码', 'verification code'

    if zh:
        subject = 'Mnemosyne OS ' + head_zh
        text = ('欢迎使用 Mnemosyne OS，您在本次%s的验证码是 %s，有效期为 %d 分钟。\n'
                '%s\n\n'
                '在使用 Mnemosyne OS 的过程中，如果有任何建议和意见，都欢迎联系我们：\n'
                '%s/issues\n'
                '官网：%s\n\n'
                '此邮件由系统自动发送，请勿直接回复。\n\nMnemosyne OS'
                % (act_zh, code, minutes, tail_zh, REPO, BASE))
    else:
        subject = 'Mnemosyne OS ' + head_en
        text = ('Welcome to Mnemosyne OS. Your %s code is %s, valid for %d minutes.\n'
                '%s\n\n'
                'If you have any suggestions or comments while using Mnemosyne OS,'
                ' we would like to hear them:\n'
                '%s/issues\n'
                'Website: %s\n\n'
                'This message was sent automatically — please do not reply.\n\nMnemosyne OS'
                % (act_en, code, minutes, tail_en, REPO, BASE))
    html = otp_mail_html(code, minutes, act_zh if zh else act_en,
                         tail_zh if zh else tail_en, zh)
    return subject, text, html


# -------------------------------------------------------------------- avatars

AVATAR_MAX_BYTES = 512 * 1024
AVATAR_TYPES = {'image/png': 'png', 'image/jpeg': 'jpg',
                'image/webp': 'webp', 'image/gif': 'gif'}
AVATAR_MAGIC = {'png': b'\x89PNG\r\n\x1a\n', 'jpg': b'\xff\xd8\xff',
                'webp': b'RIFF', 'gif': b'GIF8'}


def avatar_store(data_url):
    """Persist a data: URL as an avatar. Returns (ok, filename-or-reason).

    The file name is the content hash, so the same picture is stored once and
    its URL is unguessable; the magic bytes are checked as well as the MIME
    type, so renaming a file cannot smuggle something else in.
    """
    import base64
    m = re.match(r'^data:([A-Za-z0-9/+.-]+);base64,([A-Za-z0-9+/=\s]+)$',
                 str(data_url or ''), re.S)
    if not m:
        return False, 'bad_data'
    ext = AVATAR_TYPES.get(m.group(1).lower())
    if not ext:
        return False, 'bad_type'
    try:
        blob = base64.b64decode(re.sub(r'\s+', '', m.group(2)), validate=True)
    except Exception:
        return False, 'bad_base64'
    if not blob:
        return False, 'empty'
    if len(blob) > AVATAR_MAX_BYTES:
        return False, 'too_large'
    if not blob.startswith(AVATAR_MAGIC.get(ext, b'')):
        return False, 'bad_magic'
    name = hashlib.sha256(blob).hexdigest()[:20] + '.' + ext
    try:
        os.makedirs(AVATAR_DIR, exist_ok=True)
        path = os.path.join(AVATAR_DIR, name)
        if not os.path.exists(path):
            tmp = path + '.tmp'
            with open(tmp, 'wb') as fh:
                fh.write(blob)
            os.replace(tmp, path)
    except Exception as exc:                          # noqa: BLE001
        return False, 'write:' + str(exc)[:60]
    return True, name


