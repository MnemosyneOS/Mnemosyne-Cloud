def _site_cookie_domain(base):
    """The scope that https://ai-memory.net and https://www.ai-memory.net share.

    Without it the session cookie is host-only, so signing in on one host
    leaves the other answering 401 — the "I was logged in a minute ago"
    complaint. Derived from the configured base URL (never hard-coded), and
    left empty for localhost / bare-IP deployments, where a Domain attribute
    would be rejected outright.
    """
    host = (urllib.parse.urlparse(base).hostname or '').strip('.')
    if not host or host == 'localhost' or re.match(r'^[\d.]+$', host):
        return ''
    parts = host.split('.')
    return '.' + '.'.join(parts[-2:]) if len(parts) >= 2 else ''


