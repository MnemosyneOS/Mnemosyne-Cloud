    def handle_dash_smtp(self, save=False):
        me = self.dash_admin_guard()
        if not me:
            return
        if not save:
            return self.send_json(200, {'smtp': smtp_public()})
        body = self.body_json() or {}
        cur = load_json(SMTP_PATH, {}) or {}
        for k, limit in (('host', 120), ('user', 160), ('from', 160), ('security', 12)):
            if k in body:
                cur[k] = str(body.get(k) or '').strip()[:limit]
        if 'port' in body:
