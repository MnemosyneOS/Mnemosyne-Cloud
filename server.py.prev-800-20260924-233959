    def handle_dash_smtp_test(self):
        me = self.dash_admin_guard()
        if not me:
            return
        body = self.body_json() or {}
        to = str(body.get('to') or '').strip()
        if not EMAIL_RE.match(to):
            # Fall back to the signed-in address, then to the configured
            # sender. A GitHub sign-in carries no e-mail, and "give me an
            # address" is a poor answer when the form already names one.
            sess = self.session_payload(self.current_session())
            to = str(sess.get('email') or '').strip()
        if not EMAIL_RE.match(to):
            cfg = smtp_config()
            to = str(cfg.get('from') or cfg.get('user') or '').strip()
        if not EMAIL_RE.match(to):
            return self.send_json(400, {'error': 'bad_email',
                                        'message': 'Give an address to send the test to.'})
        ok, detail = send_mail(to, 'Mnemosyne OS test message',
                               'This is a test from the Mnemosyne console.\n'
                               'If you can read this, sign-up verification codes will arrive too.')
        return self.send_json(200, {'ok': ok, 'detail': detail, 'to': to})

