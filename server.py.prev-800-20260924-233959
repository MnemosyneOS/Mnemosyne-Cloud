    # ------------------------------------------------------------- copilot

    # ------------------------------------------------------------ copilot
    #
    # Two layers, in this order:
    #   1. the language model, fed with this project's own records;
    #   2. a deterministic retrieval answer, used when no model is configured
    #      or the provider refuses.
    # The response always says which layer produced it, so the page never
    # implies a model was called when it was not.

    COPILOT_SYSTEM = (
        "你是 Mnemosyne OS 控制台的副驾驶。Mnemosyne OS 是一个本地优先的 AI 记忆系统："
        "20 个 MCP 工具、零第三方依赖、数据留在使用者自己的机器上。\n"
        "回答必须严格依据下面给出的『项目数据』，不得编造数字、记忆内容或功能。\n"
        "如果项目数据不足以回答，就直接说明缺少什么，并建议使用者去哪里看。\n"
        "用简体中文回答，语气克制、具体，先给结论再给依据；不要用 markdown 标题，"
        "可以用短横线列点。全文控制在 220 字以内。"
    )

    def copilot_context(self, q):
        """Everything the answer may rely on, gathered from the gateway."""
        ctx = {'counts': {}, 'kinds': [], 'top': [], 'graph': {}, 'errors': []}
        ok, st = gateway('/api/status')
        if ok and isinstance(st, dict):
            stats = st.get('stats') or {}
            metrics = st.get('metrics') or {}
            ctx['counts'] = {
                'memories': st.get('count') or metrics.get('memories_active') or 0,
                'today_retain': stats.get('today_retain') or 0,
                'today_recall': stats.get('today_recall') or 0,
                'hit_rate': stats.get('today_hit_rate'),
                'saved_tokens': stats.get('today_saved_tokens') or 0,
                'write_ms': metrics.get('write_p50_ms') or metrics.get('avg_write_ms'),
            }
        else:
            ctx['errors'].append('status')

        okf, fc = gateway('/api/facets')
        if okf and isinstance(fc, dict):
            total = sum(int(k.get('count') or 0) for k in (fc.get('kinds') or [])) or 1
            ctx['kinds'] = [{'key': k.get('key'), 'count': k.get('count') or 0,
                             'pct': round((k.get('count') or 0) * 100.0 / total, 1)}
                            for k in (fc.get('kinds') or [])]
        else:
            ctx['errors'].append('facets')

        # the question is used as a search term, so the model sees the records
        # that actually relate to it rather than a random sample
        path = '/api/memories?limit=12&q=' + urllib.parse.quote(str(q)[:120])
        okm, mm = gateway(path, timeout=25)
        items = (mm.get('items') if isinstance(mm, dict) else None) or []
        for it in items[:12]:
            ctx['top'].append({
                'id': str(it.get('id') or ''),
                'excerpt': str(it.get('excerpt') or it.get('text') or it.get('content') or '')[:260],
                'kind': it.get('mtype') or it.get('kind') or '',
                'tags': (it.get('tags') or [])[:6],
                'at': it.get('created_at') or it.get('ts') or '',
            })
        if not okm:
            ctx['errors'].append('memories')
        return ctx

    def copilot_prompt(self, q, ctx):
        c = ctx.get('counts') or {}
        lines = []
        lines.append('【项目数据】')
        lines.append('- 记忆总数：%s 条' % c.get('memories', '未知'))
        lines.append('- 今日写入：%s 条；今日召回：%s 次；命中率：%s'
                     % (c.get('today_retain', '?'), c.get('today_recall', '?'),
                        c.get('hit_rate', '?')))
        lines.append('- 今日节省 token：%s' % c.get('saved_tokens', '?'))
        if ctx.get('kinds'):
            lines.append('- 记忆类别：' + '，'.join(
                '%s %s 条(%.1f%%)' % (k['key'], k['count'], k['pct']) for k in ctx['kinds'][:8]))
        if ctx.get('top'):
            lines.append('')
            lines.append('【与问题最相关的记忆片段】')
            for i, it in enumerate(ctx['top'], 1):
                lines.append('%d. [%s] %s' % (i, it['id'][:10], it['excerpt'].replace('\n', ' ')))
        if ctx.get('errors'):
            lines.append('')
            lines.append('（以下数据本次未取到：%s）' % '、'.join(ctx['errors']))
        zh = str(q).strip()
        lines.append('')
        lines.append('【问题】' + zh)
        return '\n'.join(lines)

    def handle_dash_copilot(self):
        me = self.dash_admin_guard()
        if not me:
            return
        body = self.body_json() or {}
        q = str(body.get('q') or '').strip()[:300]
        if not q:
            return self.send_json(400, {'error': 'bad_request', 'message': 'Ask something.'})

        ctx = self.copilot_context(q)
        zh = lang_is_zh(self)
        if not zh:
            sys_prompt = ('You are the Copilot in the Mnemosyne OS console. Mnemosyne OS is a '
                          'local-first AI memory system: 20 MCP tools, no third-party '
                          'dependencies, data stays on the operator\u2019s own machine.\n'
                          'Answer strictly from the PROJECT DATA below. Never invent numbers, '
                          'memory contents or features. If the data is insufficient, say what is '
                          'missing and where to look instead. Answer in English, concrete and '
                          'restrained, conclusion first; no markdown headings, short dashes are '
                          'fine. Keep it under 200 words.')
        else:
            sys_prompt = self.COPILOT_SYSTEM

        ok, text, meta = llm_chat([
            {'role': 'system', 'content': sys_prompt},
            {'role': 'user', 'content': self.copilot_prompt(q, ctx)},
        ], max_tokens=900, temperature=0.25)

        cites = [{'id': it['id'], 'excerpt': it['excerpt'][:160]} for it in (ctx.get('top') or [])]

        if ok:
            return self.send_json(200, {
                'answer': text, 'citations': cites[:6],
                'llm': {'ok': True, 'model': meta.get('model'),
                        'usage': meta.get('usage') or {}},
                'source': 'llm',
                'context': {'memories': len(ctx.get('top') or []),
                            'kinds': len(ctx.get('kinds') or [])},
            })

        # No model → answer from the records themselves, and say why.
        fallback = self.copilot_retrieval(q, ctx)
        return self.send_json(200, {
            'answer': fallback, 'citations': cites[:6],
            'llm': {'ok': False, 'error': meta.get('error'), 'detail': meta.get('detail'),
                    'model': meta.get('model')},
            'source': 'retrieval',
        })

    def copilot_retrieval(self, q, ctx):
        """Deterministic answer assembled from the gateway's own records."""
        zh = lang_is_zh(self)
        low = q.lower()

        def has(*words):
            return any(w in low or w in q for w in words)

        kinds = ctx.get('kinds') or []
        top = ctx.get('top') or []
        counts = ctx.get('counts') or {}

        if has('关系', '关联', '连接', '图谱', 'network', 'relate', 'graph'):
            okg, g = gateway('/api/graph', timeout=25)
            g = g if isinstance(g, dict) else {}
            deg = {}
            for e in (g.get('edges') or []):
                deg[e.get('source')] = deg.get(e.get('source'), 0) + 1
            labels = {n.get('id'): (n.get('label') or '') for n in (g.get('nodes') or [])}
            head = ('图谱共 %d 个节点、%d 条边。连接最多的节点：' %
                    (len(g.get('nodes') or []), len(g.get('edges') or []))) if zh else \
                   ('The graph holds %d nodes and %d edges. Most connected:' %
                    (len(g.get('nodes') or []), len(g.get('edges') or [])))
            lines = [head]
            for nid, n in sorted(deg.items(), key=lambda kv: -kv[1])[:5]:
                lines.append('  · %s —— %d' % ((labels.get(nid) or nid)[:60], n))
            return '\n'.join(lines)

        if has('包含哪些', '有哪些内容', '类别', '类型', '构成', '包含什么',
               'contain', 'kind', 'class', 'categor'):
            if zh:
                lines = ['本项目共 %s 条记忆，按类别分布：' % counts.get('memories', '?')]
            else:
                lines = ['This project holds %s memories, by kind:' % counts.get('memories', '?')]
            for k in kinds[:8]:
                lines.append('  · %s —— %d (%.0f%%)' % (k['key'], k['count'], k['pct']))
            return '\n'.join(lines)

        if has('用户', '谁写', 'who', 'agent'):
            agents = []
            okf, fc = gateway('/api/facets')
            if okf and isinstance(fc, dict):
                agents = fc.get('agents') or []
            if agents:
                head = '写入来源（Agent）：' if zh else 'Writers (agents):'
                return head + '\n' + '\n'.join(
                    '  · %s —— %s' % (a.get('key'), a.get('count')) for a in agents[:8])
            return ('本项目的写入来源在 请求 页面可以逐条查看。' if zh
                    else 'Per-request writers are listed on the Requests page.')

        if top:
            head = ('最相关的 %d 条记忆：' % len(top)) if zh else ('%d most relevant memories:' % len(top))
            lines = [head]
            for it in top[:5]:
                lines.append('  · [%s] %s' % (it['id'][:10], it['excerpt'][:120].replace('\n', ' ')))
            lines.append('')
            lines.append('（未调用大模型：%s）' % (llm_public().get('source') if zh
                                            else llm_public().get('source')))
            return '\n'.join(lines)
        return ('没有检索到相关记忆。可以换一个说法，或到「回忆」页面浏览全部记录。' if zh
                else 'No related memories were found. Try different wording, or browse the Memories page.')

    # --------------------------------------------------- model / mail settings

    def handle_dash_llm(self, save=False):
