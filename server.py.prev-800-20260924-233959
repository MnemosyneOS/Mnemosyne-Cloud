    # ---------------------------------------------------------------- keys

    def handle_dash_keys(self, qs, create=False):
        me = self.dash_admin_guard()
        if not me:
            return
        with LOCK:
            state = dash_state()
            if create:
                body = self.body_json() or {}
                name = str(body.get('name') or 'Default Key')[:60]
                raw = 'mn-' + secrets.token_urlsafe(30)
                row = {
                    'id': secrets.token_hex(6),
                    'name': name,
                    'prefix': raw[:11],
                    'sha256': hashlib.sha256(raw.encode('utf-8')).hexdigest(),
                    'created_at': time.time(),
                    'last_used': 0,
