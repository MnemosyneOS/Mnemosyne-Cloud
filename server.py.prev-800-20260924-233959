                        '所以我不会用脚本冒充它们。真要清空，请在记忆系统宿主机上执行 '
                        '`mnemosyne forget --all`（会先落一份备份），或者告诉我，我按你的确认逐批做并留备份。'
                        if lang_is_zh(self) else
                        'Nothing was deleted. The gateway exposes per-memory forget only — there '
                        'is no bulk delete, and this console will not fake one. Run '
                        '`mnemosyne forget --all` on the host (it writes a backup first), or tell '
                        'me and I will do it in confirmed batches with backups.'),
        })


class ExtrasMixin(object):
    """Public API, e-mail verification codes, avatars and the graph proxy.

    Mixed into Handler before BaseHTTPRequestHandler, like DashMixin.
    """

    # ------------------------------------------------------------ public API
    #
    # Keys created in the console become real credentials here. The browser
    # never talks to the memory gateway directly: it holds the gateway token,
    # a key holder does not, so every /v1 call is validated then forwarded.

    def public_key(self):
        raw = ''
        auth = self.headers.get('Authorization') or ''
        if auth.lower().startswith('bearer '):
            raw = auth[7:].strip()
        if not raw:
            raw = (self.headers.get('X-API-Key') or '').strip()
        return api_key_lookup(raw)

    def handle_public(self, path, qs):
        owner, row = self.public_key()
        if row is None:
            return self.send_json(401, {
                'error': 'unauthorized',
                'message': 'Pass a key: Authorization: Bearer mn-…',
                'docs': BASE + '/#/docs/api-reference'})

        if path in ('/v1/status', '/v1/status/'):
            ok, st = gateway('/api/status')
            if not ok:
                return self.send_json(503, {'error': 'gateway_unreachable'})
            stats = st.get('stats') or {}
            metrics = st.get('metrics') or {}
            return self.send_json(200, {
                'memories': st.get('count') or metrics.get('memories_active') or 0,
                'today': {'retain': stats.get('today_retain') or 0,
                          'recall': stats.get('today_recall') or 0,
                          'hit_rate': stats.get('today_hit_rate'),
                          'saved_tokens': stats.get('today_saved_tokens') or 0},
                'key': {'name': row.get('name'), 'prefix': row.get('prefix')},
            })

        if path in ('/v1/graph', '/v1/graph/'):
            ok, g = gateway('/api/graph', timeout=30)
            if not ok:
                return self.send_json(503, {'error': 'gateway_unreachable'})
            return self.send_json(200, g)

        if path in ('/v1/memories', '/v1/memories/'):
            if self.command == 'GET':
                q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
                try:
                    limit = max(1, min(200, int((q.get('limit') or ['20'])[0])))
                except Exception:
                    limit = 20
                try:
                    offset = max(0, int((q.get('offset') or ['0'])[0]))
                except Exception:
                    offset = 0
                term = str((q.get('q') or [''])[0])[:160]
                url = '/api/memories?limit=%d&offset=%d' % (limit, offset)
                if term:
                    url += '&q=' + urllib.parse.quote(term)
                ok, data = gateway(url, timeout=30)
                if not ok:
                    return self.send_json(503, {'error': 'gateway_unreachable'})
                return self.send_json(200, {
                    'total': data.get('total') or 0,
                    'offset': data.get('offset') or 0,
                    'limit': data.get('limit') or limit,
                    'items': data.get('items') or [],
                })

            body = self.body_json() or {}
            content = str(body.get('content') or body.get('text') or '').strip()
            if not content:
                return self.send_json(400, {'error': 'bad_request',
                                            'message': 'content is required'})
            args = {'content': content[:20000]}
            if body.get('mtype'):
                args['mtype'] = str(body.get('mtype'))[:32]
            if isinstance(body.get('tags'), list):
                args['tags'] = [str(t)[:40] for t in body['tags'][:12]]
            for k in ('confidence', 'importance'):
                if body.get(k) is not None:
                    try:
                        args[k] = float(body[k]) if k == 'confidence' else int(body[k])
                    except Exception:
                        pass
            ok, res = gateway_rpc('retain', args)
            if not ok:
                return self.send_json(502, dict(res, message='The memory store refused the write.'))
            return self.send_json(201, {'ok': True, 'memory': res})

        if path.startswith('/v1/memories/') and self.command == 'GET':
            mid = urllib.parse.unquote(path[len('/v1/memories/'):]).strip()
            if not mid:
                return self.send_json(400, {'error': 'bad_request'})
            ok, data = gateway('/api/memory/' + urllib.parse.quote(mid), timeout=25)
            if not ok:
                return self.send_json(404, {'error': 'not_found', 'id': mid})
            return self.send_json(200, data)

        if path.startswith('/v1/memories/') and self.command == 'DELETE':
            mid = urllib.parse.unquote(path[len('/v1/memories/'):]).strip()
            if not mid:
                return self.send_json(400, {'error': 'bad_request'})
            ok, res = gateway_rpc('forget', {'memory_id': mid})
            if not ok:
                return self.send_json(502, dict(res, message='The memory store refused the delete.'))
            return self.send_json(200, {'ok': True, 'result': res})

        if path in ('/v1/recall', '/v1/recall/'):
            body = self.body_json() or {}
            query = str(body.get('query') or body.get('q') or '').strip()[:300]
            if not query:
                return self.send_json(400, {'error': 'bad_request',
                                            'message': 'query is required'})
            args = {'query': query}
            try:
                args['k'] = max(1, min(50, int(body.get('k') or 5)))
            except Exception:
                args['k'] = 5
            ok, res = gateway_rpc('recall', args)
            if not ok:
                return self.send_json(502, dict(res, message='The memory store refused the query.'))
            return self.send_json(200, {'ok': True, 'query': query, 'result': res})

        return self.send_json(404, {
            'error': 'not_found',
            'endpoints': ['GET /v1/status', 'GET /v1/memories', 'POST /v1/memories',
                          'GET /v1/memories/{id}', 'DELETE /v1/memories/{id}',
                          'POST /v1/recall', 'GET /v1/graph']})

    # -------------------------------------------------- verification codes

    def handle_auth_methods(self):
        """What the sign-up form can offer, so it never shows a dead field."""
        return self.send_json(200, {
            'emailPassword': True,
            'emailCode': smtp_ready(),
            'mailConfigured': smtp_ready(),
            'github': GH_CONFIGURED,
        })

    def handle_send_code(self):
        """Issue a 6-digit code and mail it. Purpose decides the wording."""
        data = self.body_json() or {}
        email = str(data.get('email') or '').strip().lower()
        purpose = str(data.get('purpose') or 'signup').strip().lower()
        if purpose not in ('signup', 'signin', 'reset'):
            purpose = 'signup'
        if not EMAIL_RE.match(email) or len(email) > 200:
            return self.send_json(400, {'error': 'invalid_email',
                                        'message': 'Enter a valid email address.'})
        if not rate_ok('otp:' + self.client_ip()) or \
                otp_send_count(email, purpose) >= OTP_SEND_PER_HOUR:
            return self.send_json(429, {
                'error': 'rate_limited',
                'message': 'Too many codes requested. Wait a minute and try again.'})
        if purpose == 'signup':
            with LOCK:
                if email in (load_json(USERS_PATH, {}) or {}):
                    return self.send_json(409, {
                        'error': 'exists',
                        'message': 'That address already has an account. Sign in instead.'})
        if not smtp_ready():
            return self.send_json(503, {
                'error': 'mail_not_configured',
                'message': ('The mail sender is not configured yet, so a code cannot be sent. '
                            'Ask the site operator to add SMTP details under Console → Settings.'),
                'configure': BASE + '/#/dashboard/settings'})

        code = otp_issue(email, purpose)
        subject, body, html = otp_mail(purpose, code, lang_is_zh(self))
        ok, detail = send_mail(email, subject, body, html)
        if not ok:
            return self.send_json(502, {
                'error': 'mail_failed',
                'message': 'The code could not be delivered: %s' % detail})
        return self.send_json(200, {'ok': True, 'sentTo': email, 'expiresIn': OTP_TTL})

    # ------------------------------------------------------------- avatars

    def handle_avatar_upload(self):
        me = self.me()
        if not me:
            return self.send_json(401, {'error': 'unauthorized'})
        if getattr(self, '_oversize', 0):
            return self.send_json(413, {'error': 'payload_too_large',
                                        'message': 'Keep the picture under 512 KB.'})
        if not rate_ok('avatar:' + self.client_ip()):
            return self.send_json(429, {'error': 'rate_limited',
                                        'message': 'Too many uploads. Try again shortly.'})
        data = self.body_json() or {}
        ok, res = avatar_store(data.get('data'))
        if not ok:
            reasons = {
                'bad_data': 'Send the picture as a data: URL.',
                'bad_type': 'Use a PNG, JPEG, WebP or GIF image.',
                'bad_base64': 'The image data could not be read.',
                'empty': 'That file is empty.',
                'too_large': 'Keep the picture under 512 KB.',
                'bad_magic': 'That file is not really an image.',
            }
            return self.send_json(400, {'error': res,
                                        'message': reasons.get(res, 'Upload failed: %s' % res)})
        with LOCK:
            profiles = load_json(PROFILES_PATH, {}) or {}
            prof = profiles.get(me) or {}
            prof['avatar'] = 'api/avatar/' + res
            prof.setdefault('created_at', time.time())
            prof['updated_at'] = time.time()
            profiles[me] = prof
            save_json(PROFILES_PATH, profiles)
        return self.send_json(200, {'ok': True, 'avatar': prof['avatar']})

    def handle_avatar_remove(self):
        me = self.me()
        if not me:
            return self.send_json(401, {'error': 'unauthorized'})
        with LOCK:
            profiles = load_json(PROFILES_PATH, {}) or {}
            prof = profiles.get(me) or {}
            prof.pop('avatar', None)
            prof['updated_at'] = time.time()
            profiles[me] = prof
            save_json(PROFILES_PATH, profiles)
        return self.send_json(200, {'ok': True})

    # --------------------------------------------------------- graph proxy
    #
    # The brain graph bundle fetches `/api/graph` from whatever origin hosts
    # it. Behind a login that used to be a dead end, so the request is
    # forwarded with the gateway token and only for a signed-in visitor.

    def handle_graph_proxy(self):
        if not self.dash_session():
            return self.send_json(401, {'error': 'unauthorized',
                                        'message': 'Sign in to read the graph.'})
        ok, g = gateway('/api/graph', timeout=30)
        if not ok:
            return self.send_json(503, {'error': 'gateway_unreachable',
                                        'detail': str(g)[:200]})
        return self.send_json(200, g)

    AVATAR_RE = re.compile(r'^[0-9a-f]{20}\.(png|jpg|webp|gif)$')

    def handle_avatar_get(self, name):
        name = urllib.parse.unquote(str(name or '')).strip()
        if not self.AVATAR_RE.match(name):
            return self.send_text(404, 'Not found.')
        path = os.path.join(AVATAR_DIR, name)
        try:
            with open(path, 'rb') as fh:
                blob = fh.read()
        except Exception:
            return self.send_text(404, 'Not found.')
        ctype = 'image/png' if name.endswith('.png') else \
                'image/jpeg' if name.endswith('.jpg') else \
                'image/webp' if name.endswith('.webp') else 'image/gif'
        # the name is a content hash, so the bytes can never change under it
        return self._send(200, blob, ctype,
                          {'Cache-Control': 'public, max-age=31536000, immutable'})


def lang_is_zh(handler):
    try:
        v = handler.headers.get('X-Mn-Lang') or ''
    except Exception:
        v = ''
    return v.lower().startswith('zh')


class Handler(DashMixin, ExtrasMixin, BaseHTTPRequestHandler):
    server_version = 'mnemosyne-site'
    sys_version = ''                     # never advertise the interpreter version
    protocol_version = 'HTTP/1.1'

    def version_string(self):
        return self.server_version

    # ---------------------------------------------------------------- plumbing

    def log_message(self, fmt, *args):
        print('[%s] %s' % (time.strftime('%Y-%m-%d %H:%M:%S'), fmt % args), flush=True)

    def _send(self, code, body, ctype, extra=None):
        if isinstance(body, str):
            body = body.encode('utf-8')
        self.send_response(code)
        self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(len(body)))
        # a caller that wants a cacheable response says so in `extra`;
        # everything else stays uncacheable.
        _extra = extra or {}
        if 'Cache-Control' not in _extra:
            self.send_header('Cache-Control', 'no-store')
        for key, val in _extra.items():
            # A list value becomes one header line per item — the only way
            # to send more than one Set-Cookie without losing any.
            if isinstance(val, (list, tuple)):
                for one in val:
                    self.send_header(key, one)
            else:
                self.send_header(key, val)
        self.end_headers()
        try:
            self.wfile.write(body)
        except Exception:
            pass
        self._dash_track(code)
    def send_text(self, code, text, extra=None):
        self._send(code, text, 'text/plain; charset=utf-8', extra)

    def send_json(self, code, obj, extra=None):
        self._send(code, json.dumps(obj), 'application/json; charset=utf-8', extra)

    def redirect(self, location, extra=None):
        self._send(302, b'', 'text/plain; charset=utf-8',
                   dict({'Location': location}, **(extra or {})))

    def body_json(self):
        """Read the request body exactly once, and cache it.

        The body must be consumed on every POST, even by a handler that has no
        use for it: bytes left in the socket get glued onto the next request
        line, which is how `{}GET /api/console` (and its 501) appeared.
        """
        if getattr(self, '_body', None) is not None:
            return self._body
        try:
            n = int(self.headers.get('Content-Length') or 0)
        except Exception:
            n = 0
        raw = b''
        if n > 0:
            if n <= BODY_MAX:
                try:
                    raw = self.rfile.read(n)
                except Exception:
                    raw = b''
            else:
                # Over the cap: still read it all and throw it away. Leaving
                # the bytes in the socket makes them glue onto the next request
                # line on this kept-alive connection, which is how `{}GET …`
                # and its 501 appeared before. Refusing is a 413, not a hang.
                left = n
                try:
                    while left > 0:
                        chunk = self.rfile.read(min(65536, left))
                        if not chunk:
                            break
                        left -= len(chunk)
                except Exception:
                    pass
                self._oversize = n
                self._body = {}
                return self._body
        try:
            self._body = json.loads(raw.decode('utf-8')) if raw else {}
        except Exception:
            self._body = {}
        return self._body

    def cookies(self):
        jar = SimpleCookie()
        try:
            jar.load(self.headers.get('Cookie') or '')
        except Exception:
            return {}
        return {k: m.value for k, m in jar.items()}

    def cookie_header(self, value, max_age, host_only=False):
        bits = ['%s=%s' % (COOKIE, value), 'Path=/', 'HttpOnly', 'SameSite=Lax',
                'Max-Age=%d' % max_age]
        if SECURE_COOKIE:
            bits.append('Secure')
        if COOKIE_DOMAIN and not host_only:
            bits.append('Domain=' + COOKIE_DOMAIN)
        return '; '.join(bits)

    def cookie_headers(self, value, max_age):
        """The Set-Cookie lines for a sign-in, as a list.

        A host-only cookie and a Domain cookie coexist in the browser and are
        both sent back; the reader keeps the last one, so a stale host-only
        session written before the domain was scoped could still win. Sweeping
        it makes the result order-independent instead of merely likely.
        """
        if not COOKIE_DOMAIN:
            return [self.cookie_header(value, max_age)]
        return [self.cookie_header(value, max_age),
                self.cookie_header('', 0, host_only=True)]

    def client_ip(self):
        fwd = self.headers.get('X-Forwarded-For') or ''
        return (fwd.split(',')[0].strip() or self.client_address[0]) if fwd else self.client_address[0]

    # ----------------------------------------------------------------- session

    def current_session(self):
        sid = self.cookies().get(COOKIE)
        if not sid:
            return None
        with LOCK:
            all_sessions = load_json(SESS_PATH, {})
        entry = all_sessions.get(sid)
        if not entry:
            return None
        if time.time() - float(entry.get('at', 0)) > SESSION_DAYS * 86400:
            return None
        return entry

    def create_session(self, **fields):
        sid = secrets.token_hex(24)
        now = time.time()
        with LOCK:
            all_sessions = load_json(SESS_PATH, {})
            for key in list(all_sessions):
                if now - float(all_sessions[key].get('at', 0)) > SESSION_DAYS * 86400:
                    del all_sessions[key]
            entry = {'at': now}
            entry.update(fields)
            all_sessions[sid] = entry
            save_json(SESS_PATH, all_sessions)
        return sid

    def drop_session(self):
        sid = self.cookies().get(COOKIE)
        if not sid:
            return
        with LOCK:
            all_sessions = load_json(SESS_PATH, {})
            if sid in all_sessions:
                del all_sessions[sid]
                save_json(SESS_PATH, all_sessions)

    def session_payload(self, entry):
        """The single shape the browser ever sees for an identity.

        `id` is the stable owner key used by leads, profiles and the admin
        allowlist — an email for password accounts, `gh:<login>` for GitHub.
        """
        if not entry:
            return {'signedIn': False}
        owner = entry.get('email') or ''
        if not owner and entry.get('login'):
            owner = 'gh:' + str(entry.get('login'))
        # Carry the display name so the header can show it instead of falling
        # back to the local part of the address. profiles.json is tiny.
        prof = (load_json(PROFILES_PATH, {}) or {}).get(owner) or {}
        return {
            'signedIn': True,
            'id': owner,
            'provider': entry.get('kind') or 'password',
            'email': entry.get('email') or '',
            'name': entry.get('name') or '',
            'login': entry.get('login') or '',
            'avatar': prof.get('avatar') or '',
            'display_name': prof.get('display_name') or '',
        }

    def me(self):
        """Owner key of the caller, or '' when nobody is signed in."""
        return self.session_payload(self.current_session()).get('id') or ''

    def user_payload(self, email, name=''):
        """Shape handed back by register/login.

        It carries display_name for the same reason session_payload does: the
        header renders straight from the object the sign-in call returned, so a
        missing field means the chip silently falls back to the address.
        """
        prof = (load_json(PROFILES_PATH, {}) or {}).get(email) or {}
        return {
            'email': email,
            'name': name or '',
            'display_name': prof.get('display_name') or name or '',
            'avatar': prof.get('avatar') or '',
        }

    # -------------------------------------------------------------- accounts

    def handle_register(self):
        if not rate_ok('register:' + self.client_ip()):
            return self.send_json(429, {'error': 'rate_limited',
                                        'message': 'Too many sign-ups from this address. Try again later.'})
        data = self.body_json()
        email = str(data.get('email') or '').strip().lower()
        password = str(data.get('password') or '')
        name = str(data.get('name') or '').strip()[:60]

        if not EMAIL_RE.match(email) or len(email) > 200:
            return self.send_json(400, {'error': 'invalid_email',
                                        'message': 'Enter a valid email address.'})
        if len(password) < 8 or not re.search(r'[A-Za-z]', password) or not re.search(r'\d', password):
            return self.send_json(400, {
                'error': 'weak_password',
                'message': 'Use at least 8 characters with a letter and a number.'})

        # When a mail sender is configured the address has to be proven
        # before the account exists, so a code is required. Without a
        # sender the field is not offered at all (see /api/auth/methods)
        # and this gate stays open rather than blocking every sign-up.
        if smtp_ready():
            code = str(data.get('code') or '').strip()
            if not code:
                return self.send_json(400, {
                    'error': 'code_required',
                    'message': 'Enter the 6-digit code we mailed you.'})
            good, why = otp_check(email, 'signup', code)
            if not good:
                return self.send_json(400, {
                    'error': 'bad_code',
                    'message': {
                        'expired': 'That code has expired. Ask for a new one.',
                        'too_many': 'Too many wrong codes. Ask for a new one.',
                        'no_code': 'Ask for a code first.',
                    }.get(why, 'That code is not correct.')})

        with LOCK:
            users = load_json(USERS_PATH, {})
            if email in users:
                return self.send_json(409, {
                    'error': 'exists',
                    'message': 'That address already has an account. Sign in instead.'})
            users[email] = {
                'email': email,
                'name': name,
                'pwhash': hash_password(password),
                'created': time.time(),
                'ip': self.client_ip(),
            }
            save_json(USERS_PATH, users)
            # The display name given at sign-up goes straight into the profile,
            # so the header and the account menu can use it immediately instead
            # of showing the local part of the address until the person thinks
            # to open the console and type it a second time.
            if name:
                profiles = load_json(PROFILES_PATH, {})
                prof = profiles.get(email) or {}
                prof['display_name'] = name
                prof.setdefault('created_at', time.time())
                profiles[email] = prof
                save_json(PROFILES_PATH, profiles)

        sid = self.create_session(kind='password', email=email, name=name)
        return self.send_json(201, {'ok': True, 'user': self.user_payload(email, name)},
                              {'Set-Cookie': self.cookie_headers(sid, SESSION_DAYS * 86400)})

    def handle_login(self):
        if not rate_ok('login:' + self.client_ip()):
            return self.send_json(429, {'error': 'rate_limited',
                                        'message': 'Too many attempts. Wait a minute and try again.'})
        data = self.body_json()
        email = str(data.get('email') or '').strip().lower()
        password = str(data.get('password') or '')
        if not EMAIL_RE.match(email) or not password:
            return self.send_json(400, {'error': 'invalid_request',
                                        'message': 'Enter your email and password.'})

        with LOCK:
            users = load_json(USERS_PATH, {})
            user = users.get(email)

        # one message for "no such account" and "wrong password" — the UI must
        # not reveal which addresses are registered
        if not user or not verify_password(password, user.get('pwhash')):
            return self.send_json(401, {
                'error': 'invalid_credentials',
                'message': 'Wrong email or password.'})

        sid = self.create_session(kind='password', email=email, name=user.get('name') or '')
        return self.send_json(200, {'ok': True, 'user': self.user_payload(email, user.get('name') or '')},
                              {'Set-Cookie': self.cookie_headers(sid, SESSION_DAYS * 86400)})

    # --------------------------------------------------------------- GitHub

    def handle_authorize(self):
        if not GH_CONFIGURED:
            return self.send_text(503, 'GitHub sign-in is not configured on this deployment.')
        state = secrets.token_hex(18)
        now = time.time()
        with LOCK:
            states = load_json(STATE_PATH, {})
            for key in list(states):
                if now - float(states[key]) > STATE_TTL:
                    del states[key]
            states[state] = now
            save_json(STATE_PATH, states)

        query = urllib.parse.urlencode({
            'client_id': GH.get('clientId'),
            'redirect_uri': CALLBACK,
            'scope': 'read:user user:email',
            'state': state,
        })
        return self.redirect('https://github.com/login/oauth/authorize?' + query)

    def handle_callback(self, qs):
        code = (qs.get('code') or [''])[0]
        state = (qs.get('state') or [''])[0]

        with LOCK:
            states = load_json(STATE_PATH, {})
            known = states.pop(state, None) if state else None
            if state:
                save_json(STATE_PATH, states)
        if not known:
            return self.send_text(400, 'This sign-in link has expired. Start again from the site.')
        if not code:
            return self.redirect(BASE + '/?gh=denied#/login')

        ok, payload, raw = http_json('https://github.com/login/oauth/access_token', {
            'client_id': GH.get('clientId'),
            'client_secret': GH.get('clientSecret'),
            'code': code,
            'redirect_uri': CALLBACK,
        })
        token = (payload or {}).get('access_token')
        if not token:
            reason = 'gh:' + str((payload or {}).get('error') or 'no_token')
            if not ok and not payload:
                reason = 'net:' + (raw or 'unknown')[:90]
            print('[github] token exchange failed -> %s' % reason, flush=True)
            return self.redirect(BASE + '/?gh=token&why=' + urllib.parse.quote(reason) + '#/login')

        ok2, me, raw2 = http_json('https://api.github.com/user',
                                  headers={'Authorization': 'Bearer ' + token})
        if not (me or {}).get('login'):
            reason = ('net:' + (raw2 or 'no_body')[:90]) if not ok2 else 'gh:no_login'
            print('[github] /user failed -> %s' % reason, flush=True)
            return self.redirect(BASE + '/?gh=user&why=' + urllib.parse.quote(reason) + '#/login')

        sid = self.create_session(kind='github', login=me.get('login'),
                                  name=me.get('name') or '',
                                  avatar=me.get('avatar_url') or '')
        return self.redirect(BASE + '/?gh=ok#/login',
                             {'Set-Cookie': self.cookie_headers(sid, SESSION_DAYS * 86400)})

    # ----------------------------------------------------------------- leads

    def handle_lead(self):
        data = self.body_json()
        email = str(data.get('email') or '').strip()
        if not EMAIL_RE.match(email) or len(email) > 200:
            return self.send_json(400, {'error': 'invalid_email',
                                        'message': 'Enter a valid email address.'})
        entry = {
            'name': str(data.get('name') or '')[:120],
            'email': email,
            'company': str(data.get('company') or '')[:160],
            'message': str(data.get('message') or '')[:4000],
            'source': str(data.get('source') or 'contact')[:40],
            'lang': str(data.get('lang') or 'en')[:8],
            'owner': self.me(),
            'ip': self.client_ip(),
            'at': time.time(),
        }
        with LOCK:
            leads = load_json(LEADS_PATH, [])
            leads.append(entry)
            save_json(LEADS_PATH, leads[-2000:])
        print('[lead] %s from %s' % (email, entry['ip']), flush=True)
        return self.send_json(201, {'ok': True})

    # --------------------------------------------------------------- console

    def handle_console(self):
        """Everything the signed-in console needs, in one round trip.

        A normal member sees only the rows they own; an administrator sees
        all of them. That decision is made here, never in the browser.
        """
        payload = self.session_payload(self.current_session())
        if not payload.get('signedIn'):
            # 200 rather than 401: opening the console while signed out is an
            # ordinary state, and a 401 only adds browser console noise.
            return self.send_json(200, {'signedIn': False})
        me = payload.get('id') or ''
        with LOCK:
            leads = load_json(LEADS_PATH, [])
            profiles = load_json(PROFILES_PATH, {})
            admins = load_json(ADMINS_PATH, {})
            users = load_json(USERS_PATH, {})

        admin = me in admins
        rows = list(leads) if admin else [l for l in leads if (l.get('owner') or '') == me]
        rows.sort(key=lambda r: r.get('at') or 0, reverse=True)
        rows = [{
            'id': i,
            'name': r.get('name') or '',
            'email': r.get('email') or '',
            'company': r.get('company') or '',
            'message': r.get('message') or '',
            'source': r.get('source') or 'contact',
            'lang': r.get('lang') or 'en',
            'status': r.get('status') or 'new',
            'owner_id': r.get('owner') or '',
            'created_at': r.get('at'),
        } for i, r in enumerate(rows[:300])]

        visible = profiles if admin else ({me: profiles[me]} if me in profiles else {})
        profile_rows = [{
            'owner_id': k,
            'display_name': (v or {}).get('display_name') or '',
            'company': (v or {}).get('company') or '',
            'note': (v or {}).get('note') or '',
            'plan': (v or {}).get('plan') or 'free',
            'created_at': (v or {}).get('created_at'),
            'updated_at': (v or {}).get('updated_at'),
        } for k, v in visible.items()]

        return self.send_json(200, {
            'me': payload,
            'isAdmin': admin,
            'leads': rows,
            'profiles': profile_rows,
            'profile': profiles.get(me) or {},
            'admins': [{'owner_id': k, 'note': (v or {}).get('note', ''),
                        'created_at': (v or {}).get('at')}
                       for k, v in admins.items()],
            'users': len(users),
            'pending': len([r for r in rows if r['status'] == 'new']),
        })

    def handle_login_code(self):
        """Sign in with a mailed code instead of a password."""
        if not rate_ok('login:' + self.client_ip()):
            return self.send_json(429, {'error': 'rate_limited',
                                        'message': 'Too many attempts. Try again in a minute.'})
        data = self.body_json() or {}
        email = str(data.get('email') or '').strip().lower()
        code = str(data.get('code') or '').strip()
        if not EMAIL_RE.match(email):
            return self.send_json(400, {'error': 'invalid_email',
                                        'message': 'Enter a valid email address.'})
        if not smtp_ready():
            return self.send_json(503, {'error': 'mail_not_configured',
                                        'message': 'No mail sender is configured on this site.'})
        good, why = otp_check(email, 'signin', code)
        if not good:
            return self.send_json(400, {'error': 'bad_code',
                                        'message': {'expired': 'That code has expired.',
                                                    'too_many': 'Too many wrong codes.',
                                                    'no_code': 'Ask for a code first.',
                                                    }.get(why, 'That code is not correct.')})
        with LOCK:
            user = (load_json(USERS_PATH, {}) or {}).get(email)
        if not user:
            # Deliberately the same answer a wrong code gets: a code endpoint
            # must not become an account oracle.
            return self.send_json(400, {'error': 'bad_code',
                                        'message': 'That code is not correct.'})
        sid = self.create_session(kind='password', email=email, name=user.get('name') or '')
        return self.send_json(200, {'ok': True, 'user': self.user_payload(email, user.get('name') or '')},
                              {'Set-Cookie': self.cookie_headers(sid, SESSION_DAYS * 86400)})

    def handle_reset(self):
        """Replace the password after the address has been proven by a code.

        The reply is the same whether or not the address exists, so this cannot
        be used to find out which addresses are registered.
        """
        if not rate_ok('login:' + self.client_ip()):
            return self.send_json(429, {'error': 'rate_limited',
                                        'message': 'Too many attempts. Try again in a minute.'})
        data = self.body_json() or {}
        email = str(data.get('email') or '').strip().lower()
        code = str(data.get('code') or '').strip()
        password = str(data.get('password') or '')
        if not EMAIL_RE.match(email):
            return self.send_json(400, {'error': 'invalid_email',
                                        'message': 'Enter a valid email address.'})
        if len(password) < 8 or not re.search(r'[A-Za-z]', password) or not re.search(r'\d', password):
            return self.send_json(400, {
                'error': 'weak_password',
                'message': 'Use at least 8 characters with a letter and a number.'})
        if not smtp_ready():
            return self.send_json(503, {'error': 'mail_not_configured',
                                        'message': 'No mail sender is configured on this site.'})
        good, why = otp_check(email, 'reset', code)
        if not good:
            return self.send_json(400, {'error': 'bad_code',
                                        'message': {'expired': 'That code has expired.',
                                                    'too_many': 'Too many wrong codes.',
                                                    'no_code': 'Ask for a code first.',
                                                    }.get(why, 'That code is not correct.')})
        with LOCK:
            users = load_json(USERS_PATH, {}) or {}
            user = users.get(email)
            if user:
                user['pwhash'] = hash_password(password)
                user['pw_changed'] = time.time()
                users[email] = user
                save_json(USERS_PATH, users)
                # every existing session for that address dies with the old password
                sessions = load_json(SESS_PATH, {}) or {}
                for k in [k for k, v in sessions.items()
                          if str((v or {}).get('email') or '') == email]:
                    sessions.pop(k, None)
                save_json(SESS_PATH, sessions)
        return self.send_json(200, {'ok': True})

    def handle_change_password(self):
        """Only password accounts have a password to change."""
        if not rate_ok('change:' + self.client_ip()):
            return self.send_json(429, {'error': 'rate_limited',
                                        'message': 'Too many attempts. Wait a few minutes and try again.'})
        entry = self.current_session() or {}
        email = entry.get('email') or ''
        if not email:
            return self.send_json(401, {
                'error': 'unauthorized',
                'message': 'Sign in with an email account to change a password.'})
        data = self.body_json()
        old = str(data.get('oldPassword') or '')
        new = str(data.get('newPassword') or '')
        if len(new) < 8 or not re.search(r'[A-Za-z]', new) or not re.search(r'\d', new):
            return self.send_json(400, {
                'error': 'weak_password',
                'message': 'Use at least 8 characters with a letter and a number.'})
        with LOCK:
            users = load_json(USERS_PATH, {})
            user = users.get(email)
            if not user or not verify_password(old, user.get('pwhash')):
                return self.send_json(401, {
                    'error': 'invalid_credentials',
                    'message': 'Your current password is incorrect.'})
            user['pwhash'] = hash_password(new)
            users[email] = user
            save_json(USERS_PATH, users)
        return self.send_json(200, {'ok': True})

    def handle_profile(self):
        me = self.me()
        if not me:
            return self.send_json(401, {'error': 'unauthorized'})
        data = self.body_json()
        entry = {
            'display_name': str(data.get('display_name') or '')[:80],
            'company': str(data.get('company') or '')[:120],
            'note': str(data.get('note') or '')[:500],
            'locale': str(data.get('locale') or 'en')[:8],
            'updated_at': time.time(),
        }
        # The picture is uploaded on its own endpoint; here it only has to
        # survive a profile save. Without this a name change would drop it.
        note = []
        with LOCK:
            profiles = load_json(PROFILES_PATH, {})
            prev = profiles.get(me) or {}
            if prev.get('avatar'):
                entry['avatar'] = prev['avatar']
            if data.get('avatar_remove'):
                entry.pop('avatar', None)
            elif str(data.get('avatar') or '').startswith('data:'):
                good, name = avatar_store(data.get('avatar'))
                if good:
                    entry['avatar'] = 'api/avatar/' + name
                else:
                    note.append('avatar:' + str(name))
            entry['created_at'] = prev.get('created_at') or time.time()
            profiles[me] = entry
            save_json(PROFILES_PATH, profiles)
        return self.send_json(200, {'ok': True, 'profile': entry,
                                    'notes': note})

    def handle_claim_admin(self):
        """The first signed-in account may claim the console; afterwards the
        door is shut — the same one-shot rule the RLS policy enforced before."""
        if not rate_ok('claim:' + self.client_ip()):
            return self.send_json(429, {'error': 'rate_limited',
                                        'message': 'Too many attempts. Try again later.'})
        me = self.me()
        if not me:
            return self.send_json(401, {'error': 'unauthorized'})
        with LOCK:
            admins = load_json(ADMINS_PATH, {})
            if admins and me not in admins:
                return self.send_json(409, {
                    'error': 'exists',
                    'message': 'An administrator already exists on this site.'})
            admins[me] = {'at': time.time(), 'note': 'first claim from the console'}
            save_json(ADMINS_PATH, admins)
        return self.send_json(200, {'ok': True, 'isAdmin': True})

    # ------------------------------------------------------------ admin roster

    def admin_rows(self, admins):
        """The roster as rows the site-admin page can render."""
        with LOCK:
            profiles = load_json(PROFILES_PATH, {}) or {}
        rows = []
        for cid, rec in (admins or {}).items():
            prof = profiles.get(cid) or {}
            rows.append({
                'id': cid,
                'kind': 'github' if str(cid).startswith('gh:') else 'email',
                'display_name': prof.get('display_name') or '',
                'note': (rec or {}).get('note') or '',
                'since': (rec or {}).get('at') or 0,
            })
        rows.sort(key=lambda r: r.get('since') or 0)
        return rows

    def admin_candidates(self, admins):
        """Accounts that could be promoted — anyone who has ever signed in.

        Derived from the user table plus the GitHub logins seen in sessions,
        so the picker only ever offers identities this site has actually met.
        """
        with LOCK:
            users = load_json(USERS_PATH, {}) or {}
            sessions = load_json(SESS_PATH, {}) or {}
        seen = {}
        for email, rec in users.items():
            seen[email] = {'id': email, 'kind': 'email',
                           'name': (rec or {}).get('name') or ''}
        for rec in sessions.values():
            login = (rec or {}).get('login')
            if login:
                seen['gh:' + str(login)] = {'id': 'gh:' + str(login), 'kind': 'github',
                                            'name': (rec or {}).get('name') or str(login)}
        return [c for cid, c in sorted(seen.items()) if cid not in (admins or {})]

    def handle_admins(self, save=False):
        """Read or edit the administrator roster.

        Two rules stop the site from locking itself out, and both are enforced
        here rather than in the browser: nobody may remove their own access,
        and the last administrator cannot be removed at all. A button can be
        hidden; an endpoint decides.
        """
        me = self.dash_admin_guard()
        if not me:
            return
        actor = me.get('id') or ''
        with LOCK:
            admins = load_json(ADMINS_PATH, {}) or {}

        if not save:
            return self.send_json(200, {'admins': self.admin_rows(admins),
                                        'candidates': self.admin_candidates(admins),
                                        'me': actor})

        body = self.body_json() or {}
        action = str(body.get('action') or 'add').strip().lower()
        target = str(body.get('id') or '').strip()[:200]
        note = str(body.get('note') or '').strip()[:200]

        if action == 'add':
            if not target or not (EMAIL_RE.match(target) or target.startswith('gh:')):
                return self.send_json(400, {'error': 'bad_id',
                                            'message': 'Pick an account from the list.'})
            admins[target] = {'at': time.time(),
                              'note': note or 'added from site admin'}
            save_json(ADMINS_PATH, admins)
        elif action == 'note':
            if target not in admins:
                return self.send_json(404, {'error': 'not_found'})
            admins[target]['note'] = note
            save_json(ADMINS_PATH, admins)
        elif action == 'remove':
            if target == actor:
                return self.send_json(400, {
                    'error': 'self_removal',
                    'message': 'You cannot remove your own access — ask another administrator.'})
            if target not in admins:
                return self.send_json(404, {'error': 'not_found'})
            if len(admins) <= 1:
                return self.send_json(400, {
                    'error': 'last_admin',
                    'message': 'The last administrator cannot be removed.'})
            del admins[target]
            save_json(ADMINS_PATH, admins)
        else:
            return self.send_json(400, {'error': 'bad_action'})

        return self.send_json(200, {'ok': True, 'admins': self.admin_rows(admins),
                                    'candidates': self.admin_candidates(admins)})

    def handle_lead_update(self):
        """Triage one inbound site message: status, note, or delete.

        Rows are matched on `at` (the arrival timestamp) rather than on their
        list index, which shifts the moment anything is deleted.
        """
        me = self.dash_admin_guard()
        if not me:
            return
        body = self.body_json() or {}
        action = str(body.get('action') or 'status').strip().lower()
        stamp = str(body.get('at') or '')
        with LOCK:
            leads = load_json(LEADS_PATH, []) or []
            idx = next((i for i, r in enumerate(leads)
                        if str((r or {}).get('at') or '') == stamp and stamp), -1)
            if idx < 0:
                return self.send_json(404, {'error': 'not_found',
                                            'message': 'That message is no longer there.'})
            if action == 'delete':
                leads.pop(idx)
            elif action == 'status':
                leads[idx]['status'] = str(body.get('status') or 'new')[:20]
            elif action == 'note':
                leads[idx]['note'] = str(body.get('note') or '')[:1000]
            else:
                return self.send_json(400, {'error': 'bad_action'})
            save_json(LEADS_PATH, leads)
        return self.send_json(200, {'ok': True})

    # ------------------------------------------------------------------ ops

    def backup_info(self):
        """What is currently in the archive folder — the panel renders this."""
        files = []
        try:
            names = sorted((n for n in os.listdir(BACKUP_DIR) if n.endswith('.tar.gz')), reverse=True)
            for n in names[:24]:
                p = os.path.join(BACKUP_DIR, n)
                st = os.stat(p)
                files.append({
                    'name': n,
                    'bytes': st.st_size,
                    'at': time.strftime('%Y-%m-%d %H:%M', time.localtime(st.st_mtime)),
                })
        except Exception:
            pass
        total = sum(f['bytes'] for f in files)
        last = ''
        try:
            with open(os.path.join(BACKUP_DIR, '.last-backup'), 'r', encoding='utf-8') as fh:
                last = fh.read().strip()
        except Exception:
            pass
        return {'files': files, 'totalBytes': total, 'last': last or (files[0]['at'] if files else '')}

    def handle_ops_backup(self):
        """Run the access-log backup on demand.

        The statistics page itself sits behind Caddy's basic_auth, but this
        endpoint belongs to the account service, so it uses the account's own
        rule: only an administrator may fire it. Anonymous callers get 401 and
        signed-in members 403, which is what lets the panel tell them apart.
        """
        me = self.me()
        if not me:
            return self.send_json(401, {'error': 'unauthorized',
                                        'message': 'Sign in as an administrator first.'})
        with LOCK:
            admins = load_json(ADMINS_PATH, {})
        if me not in admins:
            # the account is echoed back so the panel can say *which* identity is
            # not an administrator — email and GitHub are two separate identities,
            # and signing in with the wrong one looks exactly like a broken button
            return self.send_json(403, {'error': 'forbidden',
                                        'account': me,
                                        'message': 'This account is not an administrator.'})
        if not rate_ok('backup:' + self.client_ip()):
            return self.send_json(429, {'error': 'rate_limited',
                                        'message': 'A backup was started moments ago. Try again shortly.'})
        try:
            proc = subprocess.run([BACKUP_SCRIPT], capture_output=True, text=True, timeout=180)
        except Exception as exc:
            return self.send_json(500, {'error': 'backup_failed', 'message': str(exc)})
        out = (proc.stdout or '').strip() or (proc.stderr or '').strip()
        if proc.returncode != 0:
            return self.send_json(500, {'error': 'backup_failed',
                                        'message': out or 'the backup script failed'})
        info = self.backup_info()
        info['ok'] = True
        info['detail'] = out
        return self.send_json(200, info)

    def handle_ops_status(self):
        """Read-only view of the backup folder (administrators only)."""
        me = self.me()
        if not me:
            return self.send_json(401, {'error': 'unauthorized', 'message': 'Sign in first.'})
        with LOCK:
            admins = load_json(ADMINS_PATH, {})
        if me not in admins:
            return self.send_json(403, {'error': 'forbidden', 'message': 'Administrators only.'})
        info = self.backup_info()
        info['ok'] = True
        return self.send_json(200, info)

    # ---------------------------------------------------------------- reports

    def handle_build(self):
        # Diagnostics. This reports absolute server paths and table row
        # counts, so it answers to the administrator only: an anonymous
        # caller has no business learning the shape of the deployment.
        # No tooling calls it, so nothing breaks by closing it.
        me = self.dash_admin_guard()
        if not me:
            return
        raw = b''
        try:
            with open(os.path.join(WEB_ROOT, 'index.html'), 'rb') as fh:
                raw = fh.read()
        except Exception:
            pass
        text = raw.decode('utf-8', 'replace')
        with LOCK:
            users = load_json(USERS_PATH, {})
            sessions = load_json(SESS_PATH, {})
            leads = load_json(LEADS_PATH, [])
            admins = load_json(ADMINS_PATH, {})
        return self.send_json(200, {
            'entryBytes': len(raw),
            'entrySha256': hashlib.sha256(raw).hexdigest()[:24],
            'hasGithubButton': '/auth/github' in text,
            'hasLocalAuth': '/api/auth/login' in text,
            'hasCodeField': 'ac-code-hint' in text,
            'hasConsoleApi': '/api/console' in text,
            'users': len(users),
            'sessions': len(sessions),
            'leads': len(leads),
            'admins': len(admins),
            'gitHubConfigured': GH_CONFIGURED,
            'webRoot': WEB_ROOT,
            'appRoot': APP_ROOT,
        })

    # --------------------------------------------------------------- dispatch

    def do_GET(self):                              # noqa: N802
        self._t0 = time.time()
        parsed_qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        self._body = None
        self._oversize = 0
        parsed = urllib.parse.urlparse(self.path)
        path, qs = parsed.path, urllib.parse.parse_qs(parsed.query)

        if path == '/auth/github':
            return self.handle_authorize()
        if path == '/auth/github/callback':
            return self.handle_callback(qs)
        if path in ('/api/session', '/api/auth/me'):
            return self.send_json(200, self.session_payload(self.current_session()))
        if path == '/api/console':
            return self.handle_console()
        if path == '/api/ops/backup-status':
            return self.handle_ops_status()
        if path == '/api/build':
            return self.handle_build()
        if path == '/healthz':
            return self.send_json(200, {'ok': True, 'github': GH_CONFIGURED})
        if path.startswith('/v1/'):
            return self.handle_public(path, qs)
        if path == '/api/graph':
            return self.handle_graph_proxy()
        if path == '/api/admin/admins':
            return self.handle_admins()
        if path == '/api/auth/methods':
            return self.handle_auth_methods()
        if path.startswith('/api/avatar/'):
            return self.handle_avatar_get(path[len('/api/avatar/'):])
        if path == '/api/dash/llm':
            return self.handle_dash_llm()
        if path == '/api/dash/smtp':
            return self.handle_dash_smtp()
        if path == '/api/dash/overview':
            return self.handle_dash_overview()
        if path == '/api/dash/memories':
            return self.handle_dash_memories(parsed_qs)
        if path == '/api/dash/facets':
            return self.handle_dash_facets()
        if path == '/api/dash/graph':
            return self.handle_dash_graph()
        if path == '/api/dash/entities':
            return self.handle_dash_entities()
        if path == '/api/dash/keys':
            return self.handle_dash_keys(parsed_qs)
        if path == '/api/dash/webhooks':
            return self.handle_dash_webhooks(parsed_qs)
        if path == '/api/dash/settings':
            return self.handle_dash_settings()
        if path == '/api/dash/requests':
            return self.handle_dash_requests()
        if path == '/api/dash/export':
            return self.handle_dash_export(parsed_qs)
        if path.startswith('/api/dash/memory/'):
            return self.handle_dash_memory(path[len('/api/dash/memory/'):])
        if path.startswith('/api/') or path.startswith('/auth/'):
            return self.send_json(404, {'error': 'not_found'})
        return self.serve_static(path)

    def do_DELETE(self):                           # noqa: N802
        """Deleting is a public-API operation only.

        Without this the base class answers 501, which is how a forgotten
        memory looked like an unimplemented method.
        """
        self._t0 = time.time()
        self._body = None
        self._oversize = 0
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        if path.startswith('/v1/'):
            return self.handle_public(path, None)
        return self.send_json(405, {'error': 'method_not_allowed',
                                    'message': 'DELETE is only supported on the /v1 API.'})

    def do_HEAD(self):                             # noqa: N802
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path.startswith('/api/') or parsed.path.startswith('/auth/'):
            return self.send_json(200, {})
        return self.serve_static(parsed.path, head_only=True)

    def do_POST(self):                             # noqa: N802
        self._t0 = time.time()
        # One TCP connection serves several requests on the SAME handler
        # instance, so the cached body has to be cleared first — otherwise the
        # second request on a kept-alive connection skips reading its own body
        # and those bytes corrupt the request after it.
        self._body = None
        self._oversize = 0
        self.body_json()                           # always drain — see body_json()
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        if path == '/api/auth/register':
            return self.handle_register()
        if path == '/api/auth/login':
            return self.handle_login()
        if path in ('/api/auth/logout', '/api/logout'):
            self.drop_session()
            return self._send(200, json.dumps({'ok': True}),
                              'application/json; charset=utf-8',
                              {'Set-Cookie': self.cookie_headers('', 0)})
        if path == '/api/auth/login-code':
            return self.handle_login_code()
        if path == '/api/auth/reset':
            return self.handle_reset()
        if path == '/api/auth/change-password':
            return self.handle_change_password()
        if path == '/api/profile':
            return self.handle_profile()
        if path == '/api/admin/claim':
            return self.handle_claim_admin()
        if path == '/api/admin/admins':
            return self.handle_admins(save=True)
        if path == '/api/admin/leads':
            return self.handle_lead_update()
        if path == '/api/ops/backup-logs':
            return self.handle_ops_backup()
        if path.startswith('/v1/'):
            return self.handle_public(path, None)
        if path == '/api/auth/send-code':
            return self.handle_send_code()
        if path == '/api/auth/methods':
            return self.handle_auth_methods()
        if path == '/api/profile/avatar':
            return self.handle_avatar_upload()
        if path == '/api/profile/avatar/remove':
            return self.handle_avatar_remove()
        if path == '/api/dash/llm':
            return self.handle_dash_llm(save=True)
        if path == '/api/dash/llm/test':
            return self.handle_dash_llm_test()
        if path == '/api/dash/smtp':
            return self.handle_dash_smtp(save=True)
        if path == '/api/dash/smtp/test':
            return self.handle_dash_smtp_test()
        if path == '/api/leads':
            return self.handle_lead()
        if path == '/api/leads':
            return self.handle_lead()
        if path == '/api/dash/keys':
            return self.handle_dash_keys(None, create=True)
        if path == '/api/dash/keys/revoke':
            return self.handle_dash_key_revoke()
        if path == '/api/dash/webhooks':
            return self.handle_dash_webhooks(None, create=True)
        if path == '/api/dash/webhooks/delete':
            return self.handle_dash_webhook_delete()
        if path == '/api/dash/settings':
            return self.handle_dash_settings(save=True)
        if path == '/api/dash/copilot':
            return self.handle_dash_copilot()
        if path == '/api/dash/danger':
            return self.handle_dash_danger()
        return self.send_json(404, {'error': 'not_found'})

    # ---------------------------------------------------------------- static

    def serve_static(self, path, head_only=False):
        """Only WEB_ROOT is reachable — the secrets live outside it."""
        try:
            path = urllib.parse.unquote(path)
        except Exception:
            return self.send_text(400, 'Bad path.')
        if not path or path == '/':
            path = '/index.html'
        if '\x00' in path or '..' in path:
            return self.send_text(404, 'Not found.')

        rel = path.lstrip('/')
        base = os.path.basename(rel)
        lower = base.lower()
        if (base in BLOCKED_NAMES
                or os.path.splitext(lower)[1] in BLOCKED_EXT
                or any(tag in lower for tag in BLOCKED_INFIX)
                or rel.split('/')[0].startswith('.')):
            return self.send_text(404, 'Not found.')

        full = os.path.abspath(os.path.join(WEB_ROOT, rel))
        if not full.startswith(os.path.abspath(WEB_ROOT)):
            return self.send_text(404, 'Not found.')
        if not os.path.isfile(full):
            return self.send_text(404, 'Not found.')

        ext = os.path.splitext(full)[1].lower()
        ctype = MIME_EXTRA.get(ext) or mimetypes.guess_type(full)[0] or 'application/octet-stream'
        try:
            with open(full, 'rb') as fh:
                blob = fh.read()
        except Exception as exc:
            print('[warn] read %s: %s' % (full, exc), flush=True)
            return self.send_text(500, 'Read error.')

        extra = {}
        if ext == '.html':
            extra['Cache-Control'] = 'no-store, no-cache, must-revalidate, max-age=0'
            extra['Pragma'] = 'no-cache'
            extra['Expires'] = '0'
            extra['Surrogate-Control'] = 'no-store'
        else:
            extra['Cache-Control'] = 'public, max-age=3600'

        if head_only:
            return self._send(200, b'', ctype, extra)
        return self._send(200, blob, ctype, extra)


def main():
    server = ThreadingHTTPServer((BIND, PORT), Handler)
    server.daemon_threads = True
    print('[mnemosyne] listening on %s:%d' % (BIND, PORT), flush=True)
    print('[mnemosyne] app root     : %s' % APP_ROOT, flush=True)
    print('[mnemosyne] web root     : %s' % WEB_ROOT, flush=True)
    print('[mnemosyne] public base  : %s' % BASE, flush=True)
    print('[mnemosyne] github cb    : %s (ready=%s)' % (CALLBACK, GH_CONFIGURED), flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == '__main__':
    main()
