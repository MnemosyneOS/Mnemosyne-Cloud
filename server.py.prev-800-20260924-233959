# Tencent drops the connection instead of answering 535 when the
# authorization code is wrong, so the raw exception reads as
# "SMTPServerDisconnected: Connection unexpectedly closed" — which points
# at the network when the real problem is the credential. Translate it.
SMTP_HINTS = (
    ('535', 'smtp_auth'),
    ('authentication', 'smtp_auth'),
    ('timed out', 'smtp_timeout'),
    ('network is unreachable', 'smtp_blocked'),
    ('name or service not known', 'smtp_dns'),
    ('certificate', 'smtp_tls'),
)

SMTP_HUMAN = {
    'smtp_refused': 'the SMTP server closed the connection right after login '
                    '(almost always a wrong authorization code, or SMTP not enabled on the mailbox)',
    'smtp_auth': 'the SMTP server rejected the login',
    'smtp_timeout': 'the SMTP server did not answer in time',
    'smtp_blocked': 'this host cannot reach the SMTP port (outbound blocked)',
    'smtp_dns': 'the SMTP host name could not be resolved',
    'smtp_tls': 'TLS negotiation with the SMTP server failed',
}


def smtp_reason(exc):
    """A short code for a failed SMTP attempt, for logs and translations."""
    name = type(exc).__name__
    if name == 'SMTPServerDisconnected':
        return 'smtp_refused'
    if name == 'SMTPAuthenticationError':
        return 'smtp_auth'
    low = str(exc).lower()
    for needle, code in SMTP_HINTS:
        if needle in low:
            return code
    if 'timeout' in name.lower():
        return 'smtp_timeout'
    return 'smtp_error'


def smtp_error_text(exc):
    """Readable failure text; the technical detail stays in brackets."""
    reason = smtp_reason(exc)
    human = SMTP_HUMAN.get(reason, 'the SMTP conversation failed')
    return '%s [%s: %s]' % (human, type(exc).__name__, exc)


def send_mail(to, subject, body_text, body_html=None):
    """Mail through the configured SMTP account. (ok, detail).

    When an HTML version is supplied both parts travel as
    multipart/alternative: plain text alone looks broken in a modern inbox,
    HTML alone disappears in a text-only reader, so neither is dropped.
    """
    import smtplib
    from email.header import Header
    from email.mime.multipart import MIMEMultipart
    from email.mime.text import MIMEText
    from email.utils import formataddr

    c = smtp_config()
    if not smtp_ready():
        return False, 'not_configured'
    host = str(c.get('host')).strip()
    try:
        port = int(c.get('port') or 465)
    except Exception:
        port = 465
    user = str(c.get('user') or '').strip()
    password = str(c.get('pass') or '')
    sender = str(c.get('from') or user).strip()
    mode = str(c.get('security') or 'ssl').lower()
    if body_html:
        msg = MIMEMultipart('alternative')
        msg.attach(MIMEText(body_text, 'plain', 'utf-8'))
        msg.attach(MIMEText(body_html, 'html', 'utf-8'))
    else:
        msg = MIMEText(body_text, 'plain', 'utf-8')
    msg['Subject'] = Header(subject, 'utf-8')
    msg['From'] = formataddr((str(Header('Mnemosyne OS', 'utf-8')), sender))
    msg['To'] = to
    try:
        if mode == 'ssl':
            conn = smtplib.SMTP_SSL(host, port, timeout=25)
        else:
            conn = smtplib.SMTP(host, port, timeout=25)
            if mode == 'starttls':
                conn.starttls()
        if user:
            conn.login(user, password)
        conn.sendmail(sender, [to], msg.as_string())
        try:
            conn.quit()
        except Exception:
            pass
        return True, 'sent'
    except Exception as exc:                          # noqa: BLE001
        return False, smtp_error_text(exc)


# ------------------------------------------------------- email one-time codes

OTP_TTL = 600               # a code is good for ten minutes
OTP_TRIES = 6               # six wrong guesses burn it
OTP_SEND_PER_HOUR = 6       # per address


def otp_issue(email, purpose):
    """Create (and return) a fresh 6-digit code, replacing any earlier one."""
    code = '%06d' % secrets.randbelow(1000000)
    key = email + '|' + purpose
    now = time.time()
    with LOCK:
        store = load_json(OTP_PATH, {}) or {}
        store[key] = {'sha256': hashlib.sha256(code.encode('utf-8')).hexdigest(),
                      'at': now, 'tries': 0, 'sends': int((store.get(key) or {}).get('sends') or 0) + 1}
        for k in [k for k, v in store.items()
                  if now - float((v or {}).get('at') or 0) > 86400]:
            store.pop(k, None)
        save_json(OTP_PATH, store)
    return code


def otp_check(email, purpose, code, consume=True):
    """(ok, reason). A used or expired code cannot be replayed."""
    key = email + '|' + purpose
    with LOCK:
        store = load_json(OTP_PATH, {}) or {}
        rec = store.get(key)
        if not rec:
            return False, 'no_code'
        if time.time() - float(rec.get('at') or 0) > OTP_TTL:
            store.pop(key, None)
            save_json(OTP_PATH, store)
            return False, 'expired'
        if int(rec.get('tries') or 0) >= OTP_TRIES:
            store.pop(key, None)
            save_json(OTP_PATH, store)
            return False, 'too_many'
        want = str(rec.get('sha256') or '')
        got = hashlib.sha256(str(code or '').strip().encode('utf-8')).hexdigest()
        if not want or not hmac.compare_digest(want, got):
            rec['tries'] = int(rec.get('tries') or 0) + 1
            store[key] = rec
            save_json(OTP_PATH, store)
            return False, 'mismatch'
        if consume:
            store.pop(key, None)
            save_json(OTP_PATH, store)
    return True, 'ok'


def otp_send_count(email, purpose):
    key = email + '|' + purpose
    rec = (load_json(OTP_PATH, {}) or {}).get(key) or {}
    if time.time() - float(rec.get('at') or 0) > 3600:
        return 0
    return int(rec.get('sends') or 0)


