def http_json(url, payload=None, headers=None, timeout=25):
    body = json.dumps(payload).encode('utf-8') if payload is not None else None
    req = urllib.request.Request(url, data=body, method='POST' if body is not None else 'GET')
    req.add_header('Accept', 'application/json')
    req.add_header('User-Agent', 'mnemosyne-site')
    if body is not None:
        req.add_header('Content-Type', 'application/json')
    for key, val in (headers or {}).items():
        req.add_header(key, val)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode('utf-8', 'replace')
            try:
                return True, json.loads(raw), raw
            except Exception:
                return False, None, raw
    except urllib.error.HTTPError as exc:
        raw = ''
        try:
            raw = exc.read().decode('utf-8', 'replace')
        except Exception:
            pass
        try:
            return False, json.loads(raw), raw
        except Exception:
            return False, None, raw or ('HTTP %s' % exc.code)
    except Exception as exc:                       # noqa: BLE001
        return False, None, '%s: %s' % (type(exc).__name__, exc)


