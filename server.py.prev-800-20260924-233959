def api_key_lookup(raw):
    """(owner, row) for a live key, else (None, None). Counts the call.

    Keys are stored as SHA-256 only: the plaintext exists once, at creation.
    """
    raw = str(raw or '').strip()
    if not raw.startswith('mn-') or len(raw) < 20:
        return None, None
    digest = hashlib.sha256(raw.encode('utf-8')).hexdigest()
    with LOCK:
        state = dash_state()
        hit = None
        for k in (state.get('keys') or []):
            if k.get('revoked'):
                continue
            if hmac.compare_digest(str(k.get('sha256') or ''), digest):
                hit = k
                break
        if hit is None:
            return None, None
        hit['calls'] = int(hit.get('calls') or 0) + 1
        hit['last_used'] = time.time()
        dash_save(state)
    return hit.get('owner') or '', hit


def gateway_rpc(tool, args, timeout=45):
    """Call one MCP tool through the gateway. (ok, result-or-error)."""
    payload = {'jsonrpc': '2.0', 'id': 1, 'method': 'tools/call',
               'params': {'name': tool, 'arguments': args or {}}}
    headers = {}
    if GW_TOKEN:
        headers['Authorization'] = 'Bearer ' + GW_TOKEN
    ok, data, raw = http_json(GATEWAY.rstrip('/') + '/mcp', payload, headers, timeout=timeout)
    if not ok:
        detail = ''
        if isinstance(data, dict):
            err = data.get('error')
            detail = (err.get('message') if isinstance(err, dict) else err) or ''
        return False, {'error': 'gateway_unreachable', 'detail': detail or str(raw)[:300]}
    if not isinstance(data, dict):
        return False, {'error': 'gateway_shape', 'detail': str(raw)[:200]}
    if data.get('error'):
        err = data['error']
        return False, {'error': 'tool_failed',
                       'detail': (err.get('message') if isinstance(err, dict) else str(err))}
    content = ((data.get('result') or {}).get('content') or [])
    if not content:
        return True, {}
    text = content[0].get('text') or ''
    try:
        return True, json.loads(text)
    except Exception:
        return True, {'raw': text}

def dash_state():
    s = load_json(DASH_PATH, {}) or {}
    s.setdefault('keys', [])
    s.setdefault('webhooks', [])
    s.setdefault('requests', [])
    s.setdefault('settings', {})
    return s


def dash_save(s):
    save_json(DASH_PATH, s)


def dash_log(state, method, path, status, ms, who):
    """A small ring buffer of dashboard/API traffic, newest first."""
    rows = state.get('requests') or []
    rows.insert(0, {'at': time.time(), 'method': method, 'path': path,
                    'status': status, 'ms': round(ms, 1), 'who': who})
    del rows[300:]
    state['requests'] = rows


class DashMixin(object):
    """Dashboard endpoints. Mixed into Handler by inheritance order."""

    # ------------------------------------------------------------- helpers

    def dash_session(self):
        payload = self.session_payload(self.current_session())
        return payload if payload.get('signedIn') else None

    def dash_guard(self):
        """(session, None) when signed in, else (None, response-sent)."""
        s = self.dash_session()
        if not s:
            self.send_json(401, {'error': 'unauthorized',
                                 'message': 'Sign in to open the console.'})
            return None
        return s

    def dash_admin_guard(self):
        """(session, None) for the site-wide console endpoints.

        Every /api/dash/* route reads the same single memory store, so a
        member account would otherwise see the owner's memories, graph,
        request log, model and mail credentials, and the public API keys.
        The check belongs here rather than in the browser: hiding a button
        stops nobody who can type curl.
        """
        s = self.dash_guard()
        if not s:
            return None
        if not self.dash_admin(s.get('id')):
            self.send_json(403, {'error': 'forbidden', 'account': s.get('id'),
                                 'message': 'This area is restricted to the site administrator.'})
            return None
        return s

    def dash_admin(self, me):
        with LOCK:
            admins = load_json(ADMINS_PATH, {})
        return me in admins

    def _dash_track(self, code):
        """Record every /api/* response into the console's request log.

        Hooked from _send() so it sees the real status, not an assumed one.
        """
        try:
            path = urllib.parse.urlparse(self.path).path
            if not path.startswith('/api/'):
                return
            t0 = getattr(self, '_t0', None)
            ms = (time.time() - t0) * 1000.0 if t0 else 0.0
            try:
                s = self.session_payload(self.current_session())
                who = s.get('id') or 'anonymous'
            except Exception:
                who = 'anonymous'
            with LOCK:
                state = dash_state()
                dash_log(state, getattr(self, 'command', 'GET'), path, code, ms, who)
                dash_save(state)
        except Exception:
            pass

    # ------------------------------------------------------------ overview

    def handle_dash_overview(self):
        me = self.dash_admin_guard()
        if not me:
            return
        ok, st = gateway('/api/status')
        okf, fc = gateway('/api/facets')
        state = dash_state()

        if not ok:
            return self.send_json(200, {
                'gateway': {'online': False, 'error': (st or {}).get('error', 'unreachable')},
                'kpi': {}, 'kinds': [], 'days': [],
                'usage': self.dash_usage(state), 'plan': PLAN_NAME,
                'limits': PLAN_LIMITS})

        stats = st.get('stats') or {}
        health = st.get('health') or {}
        metrics = st.get('metrics') or {}
        total = st.get('count') or metrics.get('memories_active') or 0

        # "oldest" is described in days, the way mem0 labels 最深的回忆
        days = (fc or {}).get('days') or []
        oldest_days = 0
        if days:
            try:
                first = sorted(d['key'] for d in days)[0]
                d0 = time.mktime(time.strptime(first, '%Y-%m-%d'))
                oldest_days = max(1, int((time.time() - d0) / 86400))
            except Exception:
                oldest_days = len(days)

        kinds = (fc or {}).get('kinds') or []
        kind_total = sum(k.get('count') or 0 for k in kinds) or 1
        kind_rows = [{'key': k.get('key'), 'count': k.get('count') or 0,
                      'pct': round((k.get('count') or 0) * 100.0 / kind_total, 1)}
                     for k in kinds]

        used = stats.get('total_memory_chars') or 0
        potential = stats.get('total_potential_chars') or 0
        util = round(stats.get('llm_feed_pct') or 0, 1)

        self.send_json(200, {
            'gateway': {
                'online': True,
                'version': health.get('version'),
                'uptimeSeconds': int(health.get('uptime_seconds') or 0),
                'sessions': health.get('sessions'),
                'requests': (health.get('stats') or {}).get('requests'),
                'errors': (health.get('stats') or {}).get('errors'),
            },
            'kpi': {
                'memories': total,
                'retainToday': stats.get('today_retain') or 0,
                'retainTotal': stats.get('total_retain') or 0,
                'recallToday': stats.get('today_recall') or 0,
                'recallTotal': stats.get('total_recall') or 0,
                'savedTokens': stats.get('saved_tokens') or 0,
                'savedTokensToday': stats.get('today_saved_tokens') or 0,
                'oldestDays': oldest_days,
                'activeDays': metrics.get('active_days') or 0,
                'hitRate': round(stats.get('total_hit_rate') or 0, 3),
                'latencyMs': round(stats.get('total_avg_latency_ms') or 0, 1),
                'llmFeedPct': util,
                'memoryChars': used,
                'potentialChars': potential,
                'writeTokens': stats.get('write_tokens') or 0,
                'recallTokens': stats.get('recall_tokens') or 0,
                'sentToLlmTokens': stats.get('sent_to_llm_tokens') or 0,
                'potentialTokens': stats.get('potential_tokens') or 0,
                'toolCount': st.get('tool_count') or 0,
            },
            'kinds': kind_rows,
            'days': days,
            'agents': (fc or {}).get('agents') or [],
            'models': (fc or {}).get('models') or [],
            'skills': (fc or {}).get('skills') or [],
            'natures': ((fc or {}).get('natures') or [])[:30],
            'usage': self.dash_usage(state),
            'plan': PLAN_NAME,
            'limits': PLAN_LIMITS,
        })

    def dash_usage(self, state):
        rows = state.get('requests') or []
        return {
            'adds': len([r for r in rows if '/add' in (r.get('path') or '')]),
            'retrieves': len([r for r in rows if '/search' in (r.get('path') or '')]),
            'keys': len([k for k in (state.get('keys') or []) if not k.get('revoked')]),
            'webhooks': len(state.get('webhooks') or []),
            'requests': len(rows),
        }

